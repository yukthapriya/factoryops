# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5433

FACTORYOPS_ENV=docker
FACTORYOPS_LOG_LEVEL=INFO
# Set to false outside local/demo environments: enables POST /api/demo/*.
FACTORYOPS_DEMO_CONTROLS_ENABLED=true

# Simulator (docker compose service)
SIM_SCENARIO=mixed
SIM_INTERVAL=2
SIM_SEED=42

# --- Local (non-Docker) development, read by the backend from backend/.env or the shell ---
# FACTORYOPS_DATABASE_URL=postgresql+psycopg://localhost:5432/factoryops
# FACTORYOPS_TEST_DATABASE_URL=postgresql+psycopg://localhost:5432/factoryops_test
# FACTORYOPS_KAFKA_BOOTSTRAP_SERVERS=localhost:29092
# FACTORYOPS_CORS_ORIGINS=["http://localhost:5173"]
